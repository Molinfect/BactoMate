%% BactoMate — full application pipeline and capabilities
%% Compatible Mermaid syntax (no ::: on subgraphs, no curly braces in labels).
%% Open in https://mermaid.live or docs/bactomate_full_pipeline.html

flowchart TB

    %% ── Workspace ──────────────────────────────────────────────
    subgraph WS["0 · Workspace and dashboard"]
        WS1["Open workspace folder"]
        WS2["bactomate_project.json paths and UI state"]
        WS3["Auto-scan: Tif_files, _segmentation_*, masks, FI, foci"]
        WS4["Session logs: save and apply parameters"]
        WS1 --> WS2 --> WS3
    end

    %% ── Conversion ───────────────────────────────────────────
    subgraph CONV["1 · File conversion"]
        C1["Input: ND2, LIF, CZI, TIFF file or folder"]
        C2["BioIO read plus legacy fallbacks"]
        C3["Frame extract: first N or single frame"]
        C4["Multi-channel split and rename"]
        C5["Optional: drift correction, bleach correction"]
        C6["Optional: crop ROI from preview"]
        C7["Optional: Z max projection"]
        C8["Edit output metadata pixel size, timing, channel names"]
        C9["Output: Tif_files/ channel stacks"]
        C1 --> C2 --> C3 --> C4
        C4 --> C5 --> C6 --> C7 --> C8 --> C9
    end

    %% ── Segmentation ─────────────────────────────────────────
    subgraph SEG["2 · Segmentation module"]
        direction TB
        S0["Input: phase TIFF from Tif_files or standalone"]
        S1["Backend: Omnipose or Cellpose-SAM or U-Net"]
        S2["Train custom models in Training module"]
        S3["Batch folder or single file"]
        S4["GPU, diameter, flow, mask threshold"]
        S5["Output masks, overlay, cellids tif and png"]
        S6["Optional Spotiflow foci detection per channel"]
        S7["foci_detection CSV and foci overlay"]
        S0 --> S1
        S2 -.-> S1
        S1 --> S3 --> S4 --> S5
        S5 --> S6 --> S7
    end

    %% ── Filtering ────────────────────────────────────────────
    subgraph FILT["3 · Filtering embedded in Segmentation module"]
        direction TB
        F1["Preview filters in right panel"]
        F2["Cell filters: area, width, length um"]
        F3["Morphology: aspect ratio, eccentricity, solidity"]
        F4["Exclude border cells"]
        F5["Foci peak filters: probability, intensity, size, per-cell ratio"]
        F6["Write filtered_masks and foci_filtered CSV"]
        F7["Filter visualization tif and png in _analysis"]
        F8["Refresh filter preview after run"]
        F1 --> F2 --> F3 --> F4
        F2 --> F5 --> F6 --> F7 --> F8
    end

    %% ── Analyze ──────────────────────────────────────────────
    subgraph ANA["4 · Analyze embedded in Segmentation module"]
        direction TB
        A1["Input: raw or filtered masks"]
        A2["Persistent Cell IDs linked across frames"]
        A3["Morphology and area per cell per frame"]
        A4["FI analysis: mean, contour, interior stats"]
        A5["Foci: Spotiflow, skimage peaks, per-cell assignment"]
        A6["Global foci_id plus cell_id link in Foci sheet"]
        A7["Spatial metrics T1-T3: contour distance, pole position, NN, temporal deltas"]
        A8["Colocalization sheets per channel pair"]
        A9["Excel: Summary, Per-Cell, Foci, Run Info"]
        A10["Optional CSV export"]
        A11["Combined summary xlsx folder aggregate"]
        A12["QC: filter and analysis visualization tif and png"]
        A1 --> A2 --> A3
        A3 --> A4
        A3 --> A5 --> A6 --> A7
        A4 --> A8
        A3 --> A9
        A9 --> A10
        A9 --> A11
        A9 --> A12
    end

    %% ── Tracking ─────────────────────────────────────────────
    subgraph TRK["5 · Tracking module"]
        direction TB
        T1["Input: mask TIFF or folder"]
        T2["Resolve phase TIFF and analysis xlsx by name"]
        T3["Trackastra: greedy, ilp, greedy_nodiv modes"]
        T4["Preview tracking in memory first N frames"]
        T5["Run tracking: full stack movement linking"]
        T6["Run lineage tracking: divisions and lineage edges"]
        T7["Track filters: length, gaps, displacement, area"]
        T8["Map track IDs to analysis Cell_ID"]
        T9["Outputs in _tracking/STEM_tracking/"]
        T10["tracks csv, masks_tracked, overlay, trajectories"]
        T11["report xlsx: Run info, raw, filtered, track_summary"]
        T12["tables/ parquet or csv.gz plus metadata.json"]
        T13["Optional CTC format export"]
        T14["Lineage curation and division review"]
        T15["Lineage analysis: family tree, traces, overlay plots"]
        T1 --> T2 --> T3
        T3 --> T4
        T3 --> T5 --> T7 --> T8 --> T9
        T3 --> T6 --> T14
        T9 --> T10 --> T11 --> T12 --> T13
        T6 --> T15
    end

    %% ── Post-processing ──────────────────────────────────────
    subgraph POST["6 · Post-processing module"]
        direction TB
        P1["Image montage from folder or file list"]
        P2["Tile layout, Z projection, labels, scale bar"]
        P3["Per-tile LUT, color, percentile overrides"]
        P4["Export PNG TIFF PDF merged or per-tile"]
        P5["Scale bar on single image"]
        P6["Growth curve video: TIFF plus analysis Excel"]
        P7["Side-by-side graph and movie with FI overlays"]
        P1 --> P2 --> P3 --> P4
        P5
        P6 --> P7
    end

    %% ── Training ─────────────────────────────────────────────
    subgraph TRAIN["7 · Training module"]
        direction TB
        TR1["Shared dataset: paired images and masks"]
        TR2["Validate pairs, preview overlays"]
        TR3["Augmentation: flip, rotate, noise, blur"]
        TR4["Backend: Omnipose fine-tune"]
        TR5["Backend: Cellpose-SAM train"]
        TR6["Backend: U-Net patch train and predict"]
        TR7["Saved model used in Segmentation module"]
        TR1 --> TR2 --> TR3
        TR3 --> TR4 --> TR7
        TR3 --> TR5 --> TR7
        TR3 --> TR6 --> TR7
    end

    %% ── CLI and batch ────────────────────────────────────────
    subgraph CLI["Command line and batch optional"]
        CL1["convert_nd2_to_tif"]
        CL2["batch_process_tiff_sequence Omnipose"]
        CL3["analyze_cell_areas"]
        CL4["assign_persistent_ids"]
        CL5["batch_process_folder full folder pipeline"]
    end

    %% ── Main flow ────────────────────────────────────────────
    WS --> CONV
    C9 --> SEG
    S5 --> FILT
    S7 --> FILT
    F6 --> ANA
    A9 --> TRK
    A9 --> POST
    TRAIN -.-> SEG

    %% ── Cross-links ──────────────────────────────────────────
    WS4 -.-> SEG
    WS4 -.-> ANA
    WS4 -.-> TRK
    CLI -.-> CONV
    CLI -.-> SEG
    CLI -.-> ANA
